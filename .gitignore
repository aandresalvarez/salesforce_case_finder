# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Credentials — never commit
.env
*.pem
*.key
*.crt
service-account*.json

# Extracted data + run artifacts never belong in git.
# The case corpus contains PHI; nothing derived from it is committable.
out/
artifacts/
logs/
data/
*.csv

# Screenshots of the running app show real cases. They are working material,
# not source, and they never belong in the repository.
Claude outputs/
*.png
*.jpg
*.jpeg

# A user's own saved views live outside the repo by default (see
# config.personal_views_path), but an overridden path could put one here. They
# hold filter definitions rather than case data, and they are still nobody
# else's business.
personal_views.json

# Build output. `uv build` writes the wheel a release is shipped as; nothing in
# here is source. Note that hatchling selects the files it packages by asking
# git what is ignored, so anything added to this file is also absent from the
# wheel — which is the intent for these two and a trap for anything else.
dist/
build/

# Local tooling
.DS_Store
.pytest_cache/
.ruff_cache/
